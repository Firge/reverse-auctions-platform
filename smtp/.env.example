# External SMTP provider used by postfix relay
SMTP_RELAY_HOST=smtp.yandex.ru
SMTP_RELAY_PORT=587
SMTP_RELAY_TLS=encrypt
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_MYHOSTNAME=mail.bebra.works

# Sender identity used by python email worker
SMTP_FROM=no-reply@bebra.works

# Worker behavior
POLL_INTERVAL_SECONDS=45
MAX_RETRY_ATTEMPTS=6
RETRY_BASE_SECONDS=60
LOOKBACK_DAYS=30
FRONTEND_AUCTION_URL_TEMPLATE=http://127.0.0.1:5173/auctions/{auction_id}
