# Image source
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=owner/reverse-auctions-platform
IMAGE_TAG=latest

# Database
POSTGRES_DB=catalog
POSTGRES_USER=catalog
POSTGRES_PASSWORD=catalog

# SMTP relay (postfix_relay)
SMTP_RELAY_HOST=smtp.yandex.ru
SMTP_RELAY_PORT=587
SMTP_RELAY_TLS=encrypt
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_MYHOSTNAME=mail.bebra.works

# Email worker
SMTP_FROM=no-reply@bebra.works
POLL_INTERVAL_SECONDS=45
MAX_RETRY_ATTEMPTS=6
RETRY_BASE_SECONDS=60
LOOKBACK_DAYS=30
FRONTEND_AUCTION_URL_TEMPLATE=https://bebra.works/auctions/{auction_id}
